# PashuSetu — required + optional environment variables
# Copy to .env.local (gitignored). Only NEXT_PUBLIC_* values reach the browser.

# ---- Required (Supabase) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional: Bhashini (GoI) multilingual voice/text ----
# Used by /lib/bhashini.ts to machine-translate advisories and synthesize TTS.
# When unset the app uses the built-in advisory library (en/hi/mr) + browser
# speech synthesis as a free, offline fallback.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# ---- Optional: Groq for fuzzy free-text symptom parsing (not used by the
#      deterministic rule engine; reserved for a future NLP enhancement) ----
# GROQ_API_KEY=

# ---- Optional: WhatsApp Cloud API for the P7 farmer channel ----
# For the WhatsApp webhook (app/api/whatsapp/webhook). When set, reply messages
# are POSTed to the Meta Graph API; when unset they are stored + shown by the
# in-app simulator (so the full report→triage→reply pipeline is demoable live).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=pashusetu-wh-verify-v1
# The WhatsApp number a farmer messages (shown on the farmer page + the wa.me
# "Open WhatsApp" deep link). Defaults to +919004553021 when unset; set this to
# the PashuSetu Business-API number once provisioned.
# WHATSAPP_FROM_NUMBER=+919004553021

# ---- Optional: Twilio (P7 stretch IVR) ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
